# For Docker Compose, use the repository-root .env.example instead.
# These variables are for manually starting the backend services.
# Auth only:
SECRET_KEY=
APP_PUBLIC_URL=http://localhost:8080
STEAM_CALLBACK_URL=http://localhost:8080/api/v1/steam/callback
# Sync only:
STEAM_API_KEY=
CATALOG_BROKER_URL=redis://enrichment-redis:6379/0
# Enrichment worker only (use localhost when Redis runs outside Compose):
ENRICHMENT_BROKER_URL=redis://enrichment-redis:6379/0
# All services (adjust host/port for your local PostgreSQL):
DATABASE_URL=postgresql+psycopg://backlog:backlog_dev_password@localhost:5433/backlog_beater

# Enrichment API and worker share a separate temporary review cache:
HLTB_REVIEW_CACHE_URL=redis://enrichment-cache:6379/0
