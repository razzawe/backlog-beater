# Copy to .env at the repository root. Never commit real secrets.
# Generate a secret with: python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=
# Match the password already used by an existing PostgreSQL volume.
# If changing this, use URL-safe characters or encode it in DATABASE_URL.
POSTGRES_PASSWORD=backlog_dev_password
STEAM_API_KEY=
APP_PUBLIC_URL=http://localhost:8080
STEAM_CALLBACK_URL=http://localhost:8080/api/v1/steam/callback

# Opt-in image batch worker. Does not start or queue work on ordinary app startup.
S3_UPLOADS_ENABLED=false
S3_COVERS_ENABLED=false
# Optional compose.s3-display.yml: isolated folder containing backlog-cover-read only.
# S3_READ_PROFILE_DIR=C:/Users/your-name/.aws-cover-read
S3_BUCKET=backlog-beater-demo
AWS_REGION=us-east-2
